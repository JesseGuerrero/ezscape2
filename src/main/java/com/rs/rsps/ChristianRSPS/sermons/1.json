{
  "Sermon": [
    "God's love is eternal,",
    "a beacon in dark times.",
    "Through faith we find hope,",
    "and through hope, peace.",
    "Life is full of trials,",
    "but Christ strengthens us.",
    "We are never alone,",
    "for God walks beside us.",
    "Trust in His divine plan.",
    "Prayers are our guide,",
    "lifting us in moments of doubt.",
    "Seek forgiveness daily,",
    "Grace is a gift freely given,",
    "we are saved through it.",
    "Love one another deeply,",
    "Kindness heals broken hearts,",
    "Hold fast to your faith,",
    "The Holy Spirit guides us,",
    "Christ has overcome the world.",
    "Go forth with courage,",
    "We are His children, loved beyond measure."
  ]
}
